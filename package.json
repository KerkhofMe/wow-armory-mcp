{
  "name": "wow-armory-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for public World of Warcraft: Forever character profiles",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
